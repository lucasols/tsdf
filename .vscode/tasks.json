{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "npm-publish",
      "label": "publish package",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "type": "npm",
      "script": "test:ui",
      "label": "run tests ui",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "type": "npm",
      "script": "test:watch",
      "label": "run tests in watch mode",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "type": "npm",
      "script": "lint",
      "problemMatcher": [],
      "label": "lint",
      "detail": "oxlint with type check + fast-lint",
      "presentation": { "clear": true }
    },
    {
      "label": "bump version and deploy",
      "type": "shell",
      "command": "pnpm run pre-publish && pnpm version ${input:version} && pnpm publish",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "version",
      "type": "pickString",
      "description": "Select version type",
      "options": ["minor", "patch", "major"]
    }
  ]
}
